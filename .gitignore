.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Editor-local config. Both name paths and ports that differ per machine — the absolute toolchain
# and IDF locations, the local clangd, the debug adapter's COM port — so neither belongs in the tree.
.vscode/settings.json
.clangd

# PC-side layout preview output (regenerate with tools/preview/preview.py)
tools/preview/out/
__pycache__/
*.pyc

# Optional separate PlatformIO cache for the ESP32-S31 preview toolchain — see
# Documentation/Display_Touch_Architecture.md §5. Only created if you opt into it.
.pio-s31/

# Upstream arduino-esp32 core, when cloned into the tree for reference. PlatformIO downloads the
# framework and its prebuilt libs itself (see Documentation/Display_Touch_Architecture.md §5), so a
# local clone is never needed for a build.
arduino-esp32/

# ESP-IDF build tree (idf/), the S31's second build system. Everything here is generated by idf.py.
# idf/sdkconfig.defaults and idf/partitions.csv are hand-written and ARE tracked, so the ignore is
# scoped to generated names rather than the directory. The wildcard covers `idf.py -B <dir>`: the
# bring-up diagnostic is built into idf/build-bringup/ so that switching between it and the OS does
# not invalidate the other's object files.
idf/build*/
idf/*.log
idf/sdkconfig
idf/sdkconfig.old
idf/managed_components/
