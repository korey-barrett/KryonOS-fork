# KryonOS on the ESP32-S31-Korvo-1 -- ESP-IDF v6.1
#
# Seeded from the working reference project for this board (D:\esp32s31_korvo1), which is the only
# proven configuration for this silicon, and pruned to what KryonOS needs. Values that look odd
# carry a comment saying why -- several of them are the difference between booting and not.

CONFIG_IDF_TARGET="esp32s31"

# --- Flash -------------------------------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# --- Partition table ---------------------------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x9000

# --- Build -------------------------------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# GCC 12+ promotes a number of warnings to errors. Vendored C (Duktape and its regexp engine) trips
# these and cannot be fixed without editing upstream sources, which this fork does not do.
CONFIG_COMPILER_DISABLE_GCC12_WARNINGS=y
CONFIG_COMPILER_DISABLE_GCC13_WARNINGS=y
CONFIG_COMPILER_DISABLE_GCC14_WARNINGS=y
CONFIG_COMPILER_DISABLE_GCC15_WARNINGS=y

# Demotes some of the -Werror pressure from third-party code, and it is worth being precise about
# which part, because it is easy to assume it does more than it does.
#
# IDF implements this (CMakeLists.txt:232) by rewriting bare `-Werror` into `-Werror=all`. Warnings
# belonging to -Wall therefore stay fatal; warnings from -Wextra and elsewhere stop being fatal.
#
# That is half of what this build needs. arduino-esp32 trips -Wmissing-field-initializers, which is a
# -Wextra warning and so is covered here. It also trips -Wstringop-truncation, which is a -Wall
# warning and is NOT covered -- that one is handled by an explicit flag in idf/CMakeLists.txt. Both
# are required; neither alone is sufficient. Verified by building with each in turn.
#
# Our own sources keep -Wall errors, which is the part worth keeping.
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

# --- PSRAM: 16 MB, octal, 200 MHz --------------------------------------------------------------
# Both RGB framebuffers and the KryonOS canvas live here, so this is not optional.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y

# Execute-in-place from PSRAM would free IRAM and keep code running while the flash cache is off,
# but IDF v6.1 has a linker-script bug with it ("cannot move location counter backwards"). The
# reference project measured this and left it off. Do not enable it until the bug is fixed.
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set

# Moving .bss into PSRAM frees ~118 KB of internal DRAM, which is tempting on this board, but the
# WiFi PHY calibration runs with the flash cache disabled and touching PSRAM .bss there raises a
# fatal cache access error. If internal RAM runs short later, move individual objects with
# EXT_RAM_BSS_ATTR instead of flipping this.
# CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY is not set

# --- CPU / RTOS --------------------------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=320
# 1000 Hz, not IDF's 100 Hz default: the display present path and the touch poll both schedule in
# single-digit milliseconds and a 10 ms tick quantises them into visible jitter.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# --- mbedTLS: PSK modes, which arduino-esp32 requires rather than merely supports -----------------
# This one is not a preference and it is not obvious from either side.
#
# arduino-esp32 4.x's NetworkClientSecure compiles ssl_client.cpp -- the file that actually
# implements TLS for WiFiClientSecure -- inside
#     #if !defined(MBEDTLS_KEY_EXCHANGE__SOME__PSK_ENABLED) && !defined(MBEDTLS_KEY_EXCHANGE_SOME_PSK_ENABLED)
#         #warning "Enable pre-shared-key ciphersuites ..."
#     #else ... whole file ... #endif
# so with PSK modes off, that translation unit builds to an EMPTY object and every symbol it owns
# (start_ssl_client, stop_ssl_socket, send_ssl_data, get_ssl_receive, ssl_init, ...) is missing.
#
# What that looks like without this line is a LINK failure, not a TLS failure, and only once
# something actually references WiFiClientSecure -- which on KryonOS is KryonHttpClient. The build is
# otherwise clean, so nothing before the final link hints at it.
#
# MBEDTLS_KEY_EXCHANGE_SOME_PSK_ENABLED is derived from this option; there is no separate switch.
# Enabling it makes PSK ciphersuites available to mbedTLS, which is a slightly wider negotiation
# surface than strictly needed -- but arduino-esp32 offers no narrower way to get a working
# WiFiClientSecure, and HTTPS is part of the fork's feature set (the app store and cloud services).
CONFIG_MBEDTLS_PSK_MODES=y

# --- Arduino as an ESP-IDF component -----------------------------------------------------------
# Lets the core start setup()/loop() itself. Without it this project would own app_main and pump the
# Arduino runtime by hand -- but KryonOS's entry point is a plain setup()/loop() pair, so owning the
# task here would mean rewriting main.cpp for the board rather than reusing it.
CONFIG_AUTOSTART_ARDUINO=y
# KryonOS's loop() drives the UI and the JS runtime, not a sketch. Measured in internal RAM.
CONFIG_ARDUINO_LOOP_STACK_SIZE=8192

# --- Board Support Package (espressif/esp32_s31_korvo_1) ----------------------------------------
# These are the BSP's own display knobs. Unlike the rest of this file they are NOT copied from the
# reference project: two of them had to change, and both are argued where they sit.

# Auto refresh -- no bounce buffer. The GDMA streams the frame buffer straight to the panel.
#
# This is the fix for the displaced picture, and it is structural rather than a tuning. In bounce
# mode the driver keeps its place in the frame in a SOFTWARE counter, bounce_pos_px, which advances
# only when its refill interrupt copies the next slice out of PSRAM before the DMA has finished
# sending the previous one. A flash write, a WiFi burst or any cache-off window can miss that
# deadline, and every slice after the miss is then offset by a whole bounce buffer -- permanently,
# because the recovery path (lcd_rgb_panel_try_restart_transmission, esp_lcd_rgb_panel_restart) is
# compiled only for CONFIG_IDF_TARGET_ESP32S3 and the underrun it would report is not a hardware
# event this SoC defines. Silent, permanent, and variable between boots: exactly what was seen.
#
# Without a bounce buffer there is no counter to lose. The DMA link is built with
# mark_final = GDMA_FINAL_LINK_TO_DEFAULT (esp_lcd_panel_rgb.c:1225), so the transfer restarts at row
# 0 of the frame buffer at the end of EVERY frame. The position lives in the DMA hardware and is
# re-established 35 times a second; a stall can corrupt one frame but cannot accumulate.
#
# Cost: none. A full 800x480x2 frame buffer needs 768000/4095 = 188 DMA descriptors
# (LCD_DMA_DESCRIPTOR_BUFFER_MAX_SIZE), at LCD_GDMA_DESCRIPTOR_ALIGN 8 bytes each -- about 1.5KB of
# internal RAM, against the 64KB the two bounce buffers themselves were occupying.
#
# The price is that the frame buffer is no longer read through the CPU, so the CPU's cached drawing
# is not automatically visible to the scanout. KorvoRgbDisplay::present() flushes it with
# esp_cache_msync; see "WHY present() IS NOT EMPTY" in KorvoRgbDisplay.h.
#
# This is also the BSP's own Kconfig default; the reference project is what overrode it.
CONFIG_BSP_LCD_RGB_REFRESH_AUTO=y

# ONE frame buffer, because KryonOS rasterizes directly into it -- the backend attaches its canvas to
# the panel's own frame buffer, so there is no second buffer to flip to and no copy to pay for.
#
# Note what that gives up. Double buffering is what would let the driver hide a redraw behind the
# panel's scanout, and on a panel with no GRAM of its own it is the only way to avoid seeing the
# redraw happen. It is not available here because KryonOS's whole drawing model assumes a single
# persistent canvas: main.cpp::loop() redraws only when the state CHANGES (drawing over the previous
# frame), so alternating buffers would leave each frame half-drawn over the other one's contents.
#
# Costs 768KB of PSRAM, which with one buffer is now free.
CONFIG_BSP_LCD_RGB_BUFFER_NUMS=1

# LVGL's anti-tearing mode is deliberately NOT enabled. It only has meaning for LVGL's own render
# loop, and KryonOS does not use LVGL -- enabling it would have the BSP fight our present path for
# the buffers.
# CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR is not set
